# Who may sign in: verified addresses at these domains (comma-separated; subdomains included)
ALLOWED_DOMAINS=your-university.edu
# The address people use to reach Labnotebook (used in sign-in links and the GitHub callback)
PUBLIC_URL=https://notes.your-lab.org

# Sign-in emails. Without SMTP_URL, sign-in links are printed in the server log instead.
SMTP_URL=
MAIL_FROM=Labnotebook <notes@your-lab.org>

# Optional: "Continue with GitHub" (callback URL: PUBLIC_URL/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: turns on AI rephrase
ANTHROPIC_API_KEY=
